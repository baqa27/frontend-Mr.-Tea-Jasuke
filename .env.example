# Semua variabel VITE_ ikut ke bundle dan dapat dibaca publik. Jangan isi secret di sini.
VITE_API_BASE_URL=https://backend-anda.onrender.com/api/v1
VITE_USE_MOCK=false
VITE_APP_ENV=production
VITE_ROUTER=browser
VITE_DASHBOARD_URL=
VITE_DASHBOARD_SIMULASI=true
VITE_FLAG_DASHBOARD=true
VITE_FLAG_RISK_MODEL=false
VITE_FLAG_ASSISTANT=true
VITE_SHOW_DEMO_ACCOUNTS=false
# Format: label|username|password;label|username|password (isi hanya di dashboard Vercel)
VITE_DEMO_ACCOUNTS=
VITE_USER_MANUAL_URL=
